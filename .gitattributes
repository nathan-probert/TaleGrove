# Shell scripts and git hooks must always use LF line endings.
# Windows checkouts (core.autocrlf=true) would otherwise store CRLF, and a
# CRLF shebang (#!/bin/sh\r) makes Linux/WSL fail to exec the hook with
# "No such file or directory" -- which aborts `git worktree add`.
*.sh text eol=lf
scripts/githooks/* text eol=lf
